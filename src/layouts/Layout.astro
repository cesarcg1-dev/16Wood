---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "16Wood | Diseño en madera",
  description = "Diseño y fabricación de productos y proyectos personalizados en madera con tecnología CNC.",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const siteUrl = Astro.site?.href ?? "https://16wood.vercel.app/";
const ogImage = `${siteUrl}images/products/caja-joyero.webp`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "16Wood",
  description,
  url: siteUrl,
  image: ogImage,
  email: "cesarcg1@gmail.com",
  telephone: "+528111917150",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Emancipacion Proletaria No. 1835",
    addressLocality: "Monterrey",
    addressRegion: "Nuevo León",
    addressCountry: "MX",
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>
    <link rel="canonical" href={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="16Wood" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Caja joyero de madera de caoba" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
